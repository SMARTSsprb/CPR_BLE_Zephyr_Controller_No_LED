/*
 * app.overlay - Devicetree overlay for ESP32-C3 Super Mini / esp32c3_devkitm
 * Mapping CPR sensors and haptic motor pins.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/pinctrl/esp32c3-pinctrl.h>

/ {
    cpr_sensors {
        compatible = "gpio-keys";
        ir1_pin: ir1 {
            gpios = <&gpio0 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "IR1 Shallow Depth Optical Sensor";
        };
        ir2_pin: ir2 {
            gpios = <&gpio0 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "IR2 Good Depth Optical Sensor";
        };
    };

    aliases {
        ir1 = &ir1_pin;
        ir2 = &ir2_pin;
        pwm-motor = &motor_pwm_0;
        i2c-bus = &i2c0;
    };

    pwm_motor_node {
        compatible = "pwm-leds";
        motor_pwm_0: motor_pwm_0 {
            pwms = <&ledc0 0 PWM_HZ(200) PWM_POLARITY_NORMAL>;
            label = "Haptic Vibrator PWM (GPIO 6)";
        };
    };
};

&user_button1 {
    status = "disabled";
};

&pinctrl {
    ledc0_cpr: ledc0_cpr {
        group1 {
            pinmux = <LEDC_CH0_GPIO6>;
            output-enable;
        };
    };

    i2c0_cpr: i2c0_cpr {
        group1 {
            pinmux = <I2C0_SDA_GPIO8>,
                     <I2C0_SCL_GPIO9>;
            bias-pull-up;
            drive-open-drain;
            output-high;
        };
    };
};

&ledc0 {
    pinctrl-0 = <&ledc0_cpr>;
    pinctrl-names = "default";
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;
    channel0@0 {
        reg = <0x0>;
        timer = <0>;
    };
};

&i2c0 {
    status = "okay";
    pinctrl-0 = <&i2c0_cpr>;
    pinctrl-names = "default";
    clock-frequency = <I2C_BITRATE_STANDARD>;
};

&adc0 {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    /* Channel 0: GPIO 0 (Chest AED Pad 49E Hall Sensor: A2) */
    channel@0 {
        reg = <0>;
        zephyr,gain = "ADC_GAIN_1_4";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };

    /* Channel 1: GPIO 1 (Hip AED Pad 49E Hall Sensor: A1) */
    channel@1 {
        reg = <1>;
        zephyr,gain = "ADC_GAIN_1_4";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };

    /* Channel 2: GPIO 2 (Battery Voltage Divider) */
    channel@2 {
        reg = <2>;
        zephyr,gain = "ADC_GAIN_1_4";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };
};
